# ============================================================================
# GPG / Crypto
# ============================================================================

# encrypt <file|directory>
# Encrypt to an armoured, timestamped .asc file alongside the original.
#
# A regular file is encrypted directly, producing <file>.<timestamp>.asc.
# A directory is first archived with zip, producing <dir>.zip.<timestamp>.asc.
# The intermediate archive is written into a private mode-0700 temporary
# directory under ${TMPDIR:-/tmp} and removed afterwards, so it never appears
# in the working directory, never lands on a network share, and cannot
# collide with, or be mistaken for, an existing file. Both output shapes end
# in .<timestamp>.asc, so decrypt() restores them without special-casing.
encrypt() {
    emulate -L zsh
    setopt localtraps

    _require "$1" "file or directory" || return 1

    local recipient
    local target="${1%/}"
    local stamp

    if [[ -f "$1" ]]; then
        recipient="$(_resolve_gpg_recipient "$GPG_ENCRYPT_KEY")" || return 1

        _gpg_publish "$1" "${1}.$(date +%Y%m%d-%H%M%S%z).asc" encryption \
            --encrypt --armor --recipient "$recipient"
        return
    fi

    [[ -d "$target" && ! -L "$target" ]] || {
        echo "no such regular file or directory: $1" >&2
        return 1
    }

    _require_cmd zip || return 1
    _require_cmd mktemp || return 1

    recipient="$(_resolve_gpg_recipient "$GPG_ENCRYPT_KEY")" || return 1

    local parent="${target:h:A}"
    local base="${target:t}"

    [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || {
        echo "cannot encrypt: $1" >&2
        return 1
    }

    stamp="$(date +%Y%m%d-%H%M%S%z)" || return 1
    local output="${parent}/${base}.zip.${stamp}.asc"

    if _path_exists "$output"; then
        echo "refusing to overwrite existing: $output" >&2
        return 1
    fi

    # The plaintext archive is created in the local temporary directory, not
    # next to the destination. On this SMB mount 'rm -rf' returns success
    # without actually unlinking the directory, so an archive staged on the
    # share survives every attempt to clean it up and leaves an unencrypted
    # copy of the whole tree behind on each run. TMPDIR is local, private,
    # and honours removal. mktemp -d gives mode 0700 regardless of umask, so
    # the plaintext is never readable by other users while it exists.
    local archive_dir
    archive_dir="$(command mktemp -d "${TMPDIR:-/tmp}/encrypt.zip.tmp.XXXXXX")" || {
        echo "could not create temporary directory in: ${TMPDIR:-/tmp}" >&2
        return 1
    }

    # Cleanup is via the EXIT trap only: in zsh a function's EXIT trap also
    # fires when a signal interrupts it, and re-raising at $$ would kill this
    # interactive shell. The path is expanded and quoted NOW, at trap-set
    # time, rather than left as a live reference: zsh pops the function's
    # local scope before running the EXIT trap, so a '$archive_dir' inside
    # single quotes would expand to nothing and clean up nothing at all.
    trap "command rm -rf -- ${(q)archive_dir} 2>/dev/null \
        || echo 'warning: plaintext archive may remain: ${archive_dir}' >&2" EXIT

    local archive="${archive_dir}/${base}.zip"

    _archive_dir "$target" "$archive" || return 1
    command chmod 600 "$archive" 2>/dev/null

    _gpg_publish "$archive" "$output" encryption \
        --encrypt --armor --recipient "$recipient" >/dev/null || return 1

    # The ciphertext is committed; remove the plaintext archive immediately
    # rather than waiting for the trap, and disarm the trap once it is gone.
    if command rm -rf -- "$archive_dir" 2>/dev/null; then
        trap - EXIT
    else
        echo "warning: ciphertext written, but plaintext archive remains: $archive_dir" >&2
    fi

    echo "$1 -> $output"
}

# decrypt <file>
# Decrypt a .asc, .gpg, .pgp, or timestamped .<timestamp>.asc file.
# Plaintext is written to a mode-0600 temporary file in the destination
# directory. The final path is created only after successful decryption.
decrypt() {
    emulate -L zsh
    setopt extendedglob

    _require "$1" "file" || return 1

    [[ -f "$1" ]] || {
        echo "no such regular file: $1" >&2
        return 1
    }

    local output="$1"

    if [[ "$1" == (#b)(*).[0-9](#c8)-[0-9](#c6)[+-][0-9](#c4).asc ]]; then
        output="$match[1]"
    else
        case "$1" in
            *.gpg)
                output="${1%.gpg}"
                ;;
            *.asc)
                output="${1%.asc}"
                ;;
            *.pgp)
                output="${1%.pgp}"
                ;;
            *)
                echo "cannot derive plaintext filename from: $1" >&2
                echo "  (expected .gpg, .asc, .pgp, or a timestamped .YYYYMMDD-HHMMSSz.asc extension)" >&2
                return 1
                ;;
        esac
    fi

    [[ -n "$output" ]] || {
        echo "cannot derive output name from: $1" >&2
        return 1
    }

    [[ "$output" != "$1" ]] || {
        echo "won't overwrite input: $1" >&2
        return 1
    }

    _gpg_publish "$1" "$output" decryption --decrypt
}

# sign <file>
# Create a detached armoured signature as file.sig.
sign() {
    emulate -L zsh
    _require "$1" "file" || return 1

    [[ -f "$1" ]] || {
        echo "no such regular file: $1" >&2
        return 1
    }

    _gpg_publish "$1" "${1}.sig" signing --armor --detach-sig
}

# verify-sig <signature> [source]
# Verify a detached signature. Without an explicit source, the signature must
# end in .sig and the source is derived by stripping that suffix. With an
# explicit source, any signature filename is accepted. encrypt() produces
# .asc ciphertext, so .asc is never treated as a signature implicitly.
verify-sig() {
    emulate -L zsh
    _require "$1" "sig-file" || return 1
    _require_cmd gpg || return 1

    (( $# <= 2 )) || {
        echo "usage: verify-sig <signature> [source]" >&2
        return 1
    }

    [[ -f "$1" ]] || {
        echo "signature file not found: $1" >&2
        return 1
    }

    local src
    if [[ -n "${2-}" ]]; then
        src="$2"
    else
        [[ "$1" == *.sig ]] || {
            echo "expected a .sig file (or pass the source file explicitly)" >&2
            return 1
        }
        src="${1%.sig}"
        [[ -n "$src" ]] || {
            echo "cannot derive source file from: $1" >&2
            return 1
        }
    fi

    [[ -f "$src" ]] || {
        echo "source file not found: $src" >&2
        return 1
    }

    command gpg --verify -- "$1" "$src"
}

# verify-dec <file>
# Test that an encrypted file decrypts without writing plaintext to disk.
verify-dec() {
    emulate -L zsh
    _require "$1" "file" || return 1
    _require_cmd gpg || return 1

    [[ -f "$1" ]] || {
        echo "encrypted file not found: $1" >&2
        return 1
    }

    if command gpg --quiet --decrypt -- "$1" >/dev/null; then
        echo "$1: OK (decrypts successfully)"
    else
        echo "$1: FAILED to decrypt" >&2
        return 1
    fi
}

# rgpg
# Restart gpg-agent.
rgpg() {
    emulate -L zsh
    _require_cmd gpg-connect-agent || return 1

    command gpg-connect-agent killagent /bye 2>/dev/null || true
    command gpg-connect-agent /bye
}

# release_card
# Best-effort cleanup: kill scdaemon and gpg-agent to release the smartcard.
# A missing gpgconf dependency fails the function; failures of the component
# terminations themselves are reported but never propagated - the consumer of
# the card (for example ykman) is the real arbiter of whether the card is
# free. The settle sleep always runs because a partial stop may still have
# released the card.
release_card() {
    emulate -L zsh
    _require_cmd gpgconf || return 1

    local -i failed=0
    command gpgconf --kill scdaemon 2>/dev/null || failed=1
    command gpgconf --kill gpg-agent 2>/dev/null || failed=1

    if (( failed )); then
        echo "warning: failed to stop one or more GPG components" >&2
    fi
    sleep 1
    return 0
}

# yk_openpgp_reset
# DESTRUCTIVE: wipe the YubiKey OpenPGP applet to factory defaults.
yk_openpgp_reset() {
    emulate -L zsh
    _require_cmd gpgconf || return 1
    _require_cmd ykman || return 1

    [[ -t 0 ]] || {
        echo "yk_openpgp_reset requires an interactive terminal" >&2
        return 1
    }

    # Best-effort; ykman will fail on its own if the card is still held.
    release_card

    echo "WARNING: this wipes all OpenPGP keys and resets PINs to factory defaults."
    printf "Type 'yes' to continue: "

    local ans
    read -r ans
    [[ "$ans" == "yes" ]] || {
        echo "Aborted."
        return 1
    }

    command ykman openpgp reset --force
}

# relearn
# Re-register the smartcard with gpg-agent.
relearn() {
    emulate -L zsh
    _require_cmd gpg-connect-agent || return 1
    command gpg-connect-agent "scd serialno" "learn --force" /bye
}

# fixyk
# Reset stale smartcard state after sleep or unplugging.
fixyk() {
    emulate -L zsh
    _require_cmd gpgconf || return 1
    _require_cmd gpg || return 1

    command gpgconf --kill scdaemon || return 1
    command gpg --card-status >/dev/null || {
        echo "card status check failed; is the YubiKey plugged in?" >&2
        return 1
    }
    echo OK
}

# ssh-agent-bw
# Point SSH at the Bitwarden SSH agent socket.
ssh-agent-bw() {
    emulate -L zsh
    local sock="$HOME/.bitwarden-ssh-agent.sock"

    [[ -S "$sock" ]] || {
        echo "SSH agent socket not found: $sock" >&2
        return 1
    }

    export SSH_AUTH_SOCK="$sock"
    echo "SSH_AUTH_SOCK -> $SSH_AUTH_SOCK"
}

# ssh-agent-gpg
# Point SSH at the gpg-agent SSH socket.
ssh-agent-gpg() {
    emulate -L zsh
    _require_cmd gpgconf || return 1

    local sock
    sock="$(command gpgconf --list-dirs agent-ssh-socket)" || {
        echo "gpgconf failed" >&2
        return 1
    }

    [[ -n "$sock" && -S "$sock" ]] || {
        echo "SSH agent socket not found: ${sock:-<empty>}" >&2
        return 1
    }

    export SSH_AUTH_SOCK="$sock"
    echo "SSH_AUTH_SOCK -> $SSH_AUTH_SOCK"
}

