# ============================================================================
# Internal helpers
# ============================================================================

# _archive_dir <directory> <archive-path>
# Create a zip archive of <directory> at <archive-path>.
#
# The archive path must not already exist; the caller is expected to supply a
# path inside a private temporary directory, which is why this helper does not
# repeat _gpg_publish's link/noclobber publishing dance.
#
# zip is run from the parent directory with the basename as its only operand,
# so stored paths are relative and extraction recreates the directory itself
# rather than a chain of leading components. -X drops extra file attributes
# (uid/gid, mac extra fields) that would otherwise leak host metadata into
# the ciphertext. Empty directories are preserved (zip stores them by default
# with -r); symbolic links are stored as links (-y) rather than followed, so
# a link pointing outside the tree cannot silently pull in unrelated data.
_archive_dir() {
    emulate -L zsh

    _require "$1" "directory" || return 1
    _require "$2" "archive-path" || return 1
    _require_cmd zip || return 1

    local source="${1%/}"
    local archive="$2"

    [[ -d "$source" && ! -L "$source" ]] || {
        echo "not a directory: $1" >&2
        return 1
    }

    local parent="${source:h:A}"
    local base="${source:t}"

    [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || {
        echo "cannot archive: $1" >&2
        return 1
    }

    [[ -d "$parent" ]] || {
        echo "parent directory does not exist: $parent" >&2
        return 1
    }

    if _path_exists "$archive"; then
        echo "refusing to overwrite existing archive: $archive" >&2
        return 1
    fi

    # A subshell keeps the cd local; the caller's working directory is
    # untouched even if zip fails.
    #
    # Info-ZIP's zip rejects '--' outright ("can't use -- before archive
    # name"), so option/operand ambiguity is handled by construction instead:
    # $archive is always absolute (it comes from a mktemp -d path), and the
    # source operand is prefixed with ./ so a directory whose name begins
    # with '-' can never be parsed as a flag.
    (
        cd -- "$parent" || exit 1
        command zip -r -q -X -y "$archive" "./$base"
    ) || {
        echo "could not create archive of: $1" >&2
        return 1
    }
}

# _require <value> <label>
# Fail with a usage message when a required argument is missing.
_require() {
    emulate -L zsh
    [[ -n "${1-}" ]] || {
        echo "usage: ${funcstack[2]} - missing: ${2:-<arg>}" >&2
        return 1
    }
}

# _require_cmd <command>
# Fail with a clear error when a required executable is unavailable.
_require_cmd() {
    emulate -L zsh
    [[ -n "${1-}" ]] || {
        echo "_require_cmd: missing command name" >&2
        return 1
    }
    command -v "$1" >/dev/null 2>&1 || {
        echo "required command not found: $1" >&2
        return 1
    }
}

# _path_exists <path>
# Treat dangling symbolic links as existing paths for overwrite protection.
_path_exists() {
    emulate -L zsh
    [[ -e "$1" || -L "$1" ]]
}

# _modhex
# Filter: translate hexadecimal on stdin to Modhex on stdout. The translation
# table lives only here. Callers are responsible for verifying tr is
# available (_require_cmd tr); this helper does not repeat the check.
_modhex() {
    emulate -L zsh
    command tr '0123456789abcdef' 'cbdefghijklnrtuv'
}

# _resolve_gpg_recipient <selector>
# Resolve a key selector to exactly one full primary-key fingerprint.
_resolve_gpg_recipient() {
    emulate -L zsh
    setopt extendedglob
    _require "$1" "GPG recipient" || return 1
    _require_cmd gpg || return 1
    _require_cmd awk || return 1

    local listing fingerprints fingerprint
    listing="$(command gpg --batch --with-colons --list-keys -- "$1" 2>/dev/null)" || {
        echo "GPG recipient not found: $1" >&2
        return 1
    }

    fingerprints="$(
        print -r -- "$listing" | command awk -F: '
            $1 == "pub" { want_fingerprint = 1; next }
            want_fingerprint && $1 == "fpr" {
                print $10
                want_fingerprint = 0
            }
        '
    )"

    [[ -n "$fingerprints" ]] || {
        echo "could not resolve a primary-key fingerprint for: $1" >&2
        return 1
    }

    if [[ "$fingerprints" == *$'\n'* ]]; then
        echo "GPG recipient selector is ambiguous: $1" >&2
        return 1
    fi

    fingerprint="$fingerprints"
    [[ "$fingerprint" == [[:xdigit:]](#c40) || "$fingerprint" == [[:xdigit:]](#c64) ]] || {
        echo "GPG returned an invalid fingerprint for: $1" >&2
        return 1
    }

    print -r -- "$fingerprint"
}

# _gpg_publish <input> <output> <label> <gpg-args...>
# Shared machinery for encrypt, decrypt, and sign: run GPG writing into a
# private mode-0700 temporary directory next to the destination, then publish
# the mode-0600 result without overwriting files or symbolic links.
#
# mktemp -d creates the temporary directory with mode 0700 regardless of the
# umask, and the output file is chmod'd 600 explicitly, so this function never
# modifies the calling shell's umask.
#
# Only the parent directory is canonicalised; the output's own name is kept
# as-is so that a symbolic link (including a dangling one) at the output name
# is detected rather than followed to its target.
#
# Cleanup uses the EXIT trap only. In zsh, a function's EXIT trap also fires
# when a signal interrupts the function, and because this library is sourced,
# re-raising a signal at $$ would kill the interactive shell.
#
# Publishing prefers a hard link, which fails atomically if the target
# already exists (including a dangling symbolic link). On filesystems that do
# not support hard links (SMB, exFAT, certain network mounts) it falls back
# to an O_EXCL exclusive create via a noclobber redirection, which still
# guarantees no overwrite, although the content copy itself is not atomic.
_gpg_publish() {
    emulate -L zsh
    setopt localtraps

    _require "$1" "input" || return 1
    _require "$2" "output" || return 1
    _require "$3" "label" || return 1
    _require_cmd gpg || return 1
    _require_cmd mktemp || return 1

    local input="$1" output="$2" label="$3"
    shift 3

    (( $# >= 1 )) || {
        echo "_gpg_publish: missing GPG options" >&2
        return 1
    }

    local output_dir="${output:h:A}"
    local output_name="${output:t}"
    local output_path="${output_dir}/${output_name}"

    [[ -d "$output_dir" ]] || {
        echo "output directory does not exist: $output_dir" >&2
        return 1
    }

    if _path_exists "$output_path"; then
        echo "refusing to overwrite existing: $output" >&2
        return 1
    fi

    local temp_dir tmp
    temp_dir="$(command mktemp -d "${output_dir}/.${output_name}.tmp.XXXXXX")" || {
        echo "could not create temporary directory in: $output_dir" >&2
        return 1
    }
    tmp="$temp_dir/output"

    trap "command rm -rf -- ${(q)temp_dir} 2>/dev/null \
        || echo 'warning: temporary data remains: ${temp_dir}' >&2" EXIT

    command gpg "$@" --output "$tmp" -- "$input" || {
        echo "$label failed: $input" >&2
        return 1
    }

    [[ -f "$tmp" ]] || {
        echo "$label produced no regular output file: $input" >&2
        return 1
    }

    # BSD chmod/ln (macOS) do not support --. Safe without it: both operands
    # are derived from ${output:h:A} and therefore always absolute paths.
    command chmod 600 "$tmp" || {
        echo "could not secure temporary output: $tmp" >&2
        return 1
    }

    # Publish without overwriting. Preferred path: a hard link, which fails
    # atomically if the target exists. Some filesystems (SMB, exFAT) do not
    # support hard links; fall back to an O_EXCL exclusive create via a
    # noclobber redirection, which still guarantees no overwrite. The
    # fallback's content copy is not atomic, so a partial file is removed on
    # copy failure (safe: the O_EXCL create proved this invocation created
    # it). chmod on the final file is best-effort because network mounts
    # often ignore or reject POSIX mode changes.
    if ! command ln "$tmp" "$output_path" 2>/dev/null; then
        setopt localoptions noclobber
        if ! command cat -- "$tmp" > "$output_path" 2>/dev/null; then
            echo "could not create final output without overwrite: $output" >&2
            return 1
        fi
        if [[ ! -s "$output_path" && -s "$tmp" ]]; then
            command rm -f -- "$output_path"
            echo "copy to final output failed: $output" >&2
            return 1
        fi
        command chmod 600 "$output_path" 2>/dev/null
    fi

    # The output is committed; leftover temporary data is only worth a
    # warning. On success temp_dir is cleared so the EXIT trap does nothing;
    # on failure it is left set so the trap retries the removal.
    if command rm -rf -- "$temp_dir" 2>/dev/null; then
        temp_dir=""
        trap - EXIT
    else
        echo "warning: output was created, but temporary data remains: $temp_dir" >&2
    fi

    echo "$input -> $output"
}

