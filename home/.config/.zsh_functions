# myip
# Show the public IPv4 address with a five-second provider timeout.
# The response must be exactly one line containing only a dotted-quad IPv4
# address; multiline bodies and carriage returns are rejected outright so
# provider error pages or captive-portal HTML are never passed through.
myip() {
    emulate -L zsh
    setopt extendedglob
    _require_cmd curl || return 1

    local ip
    ip="$(command curl -sf -4 --max-time 5 "https://icanhazip.com/")" \
        || ip="$(command curl -sf -4 --max-time 5 "https://api4.my-ip.io/ip")" \
        || return 1

    # Command substitution strips the trailing newline; any remaining line
    # break or carriage return means a malformed response.
    if [[ "$ip" == *[$'\r\n']* ]]; then
        echo "provider returned a malformed (multiline or CR) response" >&2
        return 1
    fi

    [[ "$ip" == <0-255>.<0-255>.<0-255>.<0-255> ]] || {
        echo "provider returned an invalid IPv4 address: ${ip:-<empty>}" >&2
        return 1
    }

    print -r -- "$ip"
}

# cidr
# Show the ARIN-reported CIDR block containing the public IPv4 address.
cidr() {
    emulate -L zsh
    _require_cmd whois || return 1
    _require_cmd grep || return 1

    local ip
    ip="$(myip)" || {
        echo "could not determine public IP" >&2
        return 1
    }

    command whois -h "whois.arin.net" -- "n + $ip" | command grep "CIDR:" || {
        echo "no CIDR found for $ip" >&2
        return 1
    }
}

# openpgpkey_lookup <email>
# Look up the OPENPGPKEY DNS record for an email address per RFC 7929.
# The local-part is lowercased and hashed with SHA-256; only the first 56
# hex characters of the digest are used as the DNS label. Requires dig and
# sha256sum (coreutils). Whitespace in the returned RDATA is removed and one
# trailing newline is printed. A missing record therefore produces only that
# newline. A non-zero exit from dig is propagated.
openpgpkey_lookup() {
    emulate -L zsh -o pipefail
    _require "$1" "email" || return 1
    _require_cmd dig || return 1
    _require_cmd sha256sum || return 1
    _require_cmd tr || return 1
    _require_cmd cut || return 1

    local email="$1"

    # Reject addresses that lack exactly one '@'.
    [[ "$email" == *@* && "$email" != *@*@* ]] || {
        echo "invalid email address: $email" >&2
        return 1
    }

    local local_part="${email%@*}"
    local domain="${email#*@}"

    [[ -n "$local_part" && -n "$domain" ]] || {
        echo "invalid email address: $email" >&2
        return 1
    }

    # RFC 7929 §3: hash the lowercased local-part; use the first 56 hex chars.
    local lower_part hash
    lower_part="$(printf '%s' "$local_part" | command tr '[:upper:]' '[:lower:]')"
    hash="$(printf '%s' "$lower_part" | command sha256sum | command cut -c1-56)"

    [[ ${#hash} -eq 56 ]] || {
        echo "sha256sum produced an unexpected output" >&2
        return 1
    }

    command dig +short OPENPGPKEY "${hash}._openpgpkey.${domain}" | \
        command tr -d '[:space:]' && print
}

# openpgpkey_lookup_validate <email>
# Look up an RFC 7929 OPENPGPKEY DNS record, decode and validate the returned
# OpenPGP key material, and confirm that every primary key is already present
# in the default GPG keyring. On success, print a validation summary followed
# by GPG's colon-formatted key details.
openpgpkey_lookup_validate() {
    emulate -L zsh -o pipefail
    setopt localtraps

    _require "$1" "email" || return 1
    _require_cmd base64 || return 1
    _require_cmd gpg || return 1
    _require_cmd mktemp || return 1
    _require_cmd awk || return 1

    local email="$1"

    # Keep validation consistent with openpgpkey_lookup().
    [[ "$email" == *@* && "$email" != *@*@* ]] || {
        echo "openpgpkey_lookup_validate: invalid email address: $email" >&2
        return 1
    }

    local local_part="${email%@*}"
    local domain="${email#*@}"

    [[ -n "$local_part" && -n "$domain" ]] || {
        echo "openpgpkey_lookup_validate: invalid email address: $email" >&2
        return 1
    }

    # Recreate the queried owner name for the validation summary. The lookup
    # function performs the same RFC 7929 transformation and checks these
    # dependencies itself.
    _require_cmd sha256sum || return 1
    _require_cmd tr || return 1
    _require_cmd cut || return 1

    local lower_part hash qname tmp_file
    lower_part="$(printf '%s' "$local_part" | command tr '[:upper:]' '[:lower:]')" \
        || return 1
    hash="$(printf '%s' "$lower_part" | command sha256sum | command cut -c1-56)" \
        || return 1

    [[ ${#hash} -eq 56 ]] || {
        echo "openpgpkey_lookup_validate: sha256sum produced an unexpected output" >&2
        return 1
    }

    qname="${hash}._openpgpkey.${domain}"

    tmp_file="$(command mktemp "${TMPDIR:-/tmp}/openpgpkey.XXXXXXXX")" || {
        echo "openpgpkey_lookup_validate: unable to create temporary file" >&2
        return 1
    }

    trap 'command rm -f -- "$tmp_file"' EXIT

    # Decode base64: GNU coreutils uses -d, BSD/macOS uses -D.
    # Detect which is available (GNU base64 supports --version).
    local _b64_decode=(-d)
    if ! command base64 --version >/dev/null 2>&1; then
        _b64_decode=(-D)
    fi
    if ! openpgpkey_lookup "$email" \
        | command base64 "${_b64_decode[@]}" >| "$tmp_file"
    then
        echo "openpgpkey_lookup_validate: unable to retrieve or decode DNS record" >&2
        return 1
    fi

    [[ -s "$tmp_file" ]] || {
        echo "openpgpkey_lookup_validate: no OPENPGPKEY record found for $email" >&2
        return 1
    }

    local dns_fingerprints local_fingerprint
    local -i missing=0
    local -a dns_primary_fingerprints

    dns_fingerprints="$(
        command gpg \
            --batch \
            --quiet \
            --with-colons \
            --import-options show-only \
            --import "$tmp_file" 2>/dev/null \
        | command awk -F: '
            $1 == "pub" {
                primary = 1
                next
            }
            primary && $1 == "fpr" {
                print $10
                primary = 0
            }
        '
    )" || {
        echo "openpgpkey_lookup_validate: decoded data is not a valid OpenPGP key" >&2
        return 1
    }

    [[ -n "$dns_fingerprints" ]] || {
        echo "openpgpkey_lookup_validate: decoded data is not a valid OpenPGP key" >&2
        return 1
    }

    dns_primary_fingerprints=("${(@f)dns_fingerprints}")

    for local_fingerprint in "${dns_primary_fingerprints[@]}"; do
        if ! command gpg \
            --batch \
            --quiet \
            --with-colons \
            --list-keys -- "$local_fingerprint" 2>/dev/null \
            | command awk -F: -v target="$local_fingerprint" '
                $1 == "fpr" && $10 == target {
                    found = 1
                }
                END {
                    exit(found ? 0 : 1)
                }
            '
        then
            echo \
                "openpgpkey_lookup_validate: key not found in keyring: $local_fingerprint" >&2
            missing=1
        fi
    done

    if (( missing )); then
        echo \
            "openpgpkey_lookup_validate: DNS key material does not match the local keyring" >&2
        return 1
    fi

    echo "Validated OPENPGPKEY record:"
    echo "  Email:      $email"
    echo "  DNS name:   $qname"
    echo "  Primary key(s):"

    for local_fingerprint in "${dns_primary_fingerprints[@]}"; do
        echo "    $local_fingerprint"
    done

    echo
    command gpg \
        --batch \
        --with-colons \
        --list-keys -- "${dns_primary_fingerprints[@]}"
}

# sshmount <host> <remote-path>
# Mount a remote path over SSH. A failed mount removes only a mountpoint
# directory created by this invocation. ':' is rejected because the host is
# combined into the sshfs "host:path" argument.
sshmount() {
    emulate -L zsh
    _require "$1" "host" || return 1
    _require "$2" "remote-path" || return 1
    _require_cmd sshfs || return 1

    if [[ "$1" == "." || "$1" == ".." || "$1" == -* || "$1" == */* \
        || "$1" == *:* || "$1" == *[[:space:]]* ]]; then
        echo "invalid SSH host or alias: $1" >&2
        return 1
    fi

    local mountroot="$HOME/mountpoints"
    local mountpoint="$mountroot/$1"
    local -i created=0

    command mkdir -p -- "$mountroot" || return 1

    if [[ -L "$mountpoint" ]]; then
        echo "refusing symbolic-link mountpoint: $mountpoint" >&2
        return 1
    fi

    if [[ -e "$mountpoint" && ! -d "$mountpoint" ]]; then
        echo "mountpoint exists and is not a directory: $mountpoint" >&2
        return 1
    fi

    if [[ ! -d "$mountpoint" ]]; then
        command mkdir -- "$mountpoint" || return 1
        created=1
    fi

    if command sshfs "${1}:${2}" "$mountpoint"; then
        # sshfs can exit 0 even when the background mount fails to establish,
        # so verify independently. macOS has no `mountpoint` utility; check
        # the mount table instead (match the exact " on <path> " field).
        if command mount | command grep -qF -- " on $mountpoint "; then
            echo "${1}:${2} -> $mountpoint"
            return 0
        fi
        echo "sshfs returned success but $mountpoint is not mounted" >&2
    fi

    if (( created )); then
        command rmdir -- "$mountpoint" 2>/dev/null
    fi
    return 1
}

# wakenas
# Send Wake-on-LAN packets to all configured NAS MAC addresses.
# ${=NAS_MACS} explicitly splits the space-separated string into words.
wakenas() {
    emulate -L zsh
    _require_cmd wakeonlan || return 1

    [[ -n "$NAS_MACS" ]] || {
        echo "NAS_MACS is empty" >&2
        return 1
    }

    local mac
    local -i rc=0

    for mac in ${=NAS_MACS}; do
        if command wakeonlan "$mac"; then
            echo "sent magic packet -> $mac"
        else
            echo "failed to send magic packet -> $mac" >&2
            rc=1
        fi
    done

    return $rc
}

