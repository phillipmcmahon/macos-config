# entropy <charset-size> <length>
# Calculate approximate entropy in bits.
# (Previously named 'e', renamed to avoid PATH/alias collisions.)
entropy() {
    emulate -L zsh
    _require "$1" "charset-size" || return 1
    _require "$2" "length" || return 1
    _require_cmd awk || return 1

    [[ "$1" == <-> && "$2" == <-> ]] || {
        echo "charset-size and length must be positive integers" >&2
        return 1
    }

    command awk -v c="$1" -v l="$2" '
        BEGIN {
            if (c <= 1 || l <= 0) {
                print "charset-size must exceed 1 and length must be positive" > "/dev/stderr"
                exit 1
            }
            printf "%.2f bits\n", l * log(c) / log(2)
        }
    '
}

# calc <expression>
# Evaluate an expression with floating-point calculations enabled.
# zcalc is autoloaded at file scope above.
# Example: calc '2**10 / 3.0'
calc() {
    emulate -L zsh
    _require "$1" "expression" || return 1
    zcalc -e -f "$*"
}

# colours
# Print the 256-colour terminal palette, 16 entries per row.
colours() {
    emulate -L zsh
    local i

    for i in {0..255}; do
        printf "\033[38;5;%sm%3s " "$i" "$i"
        if (( (i + 1) % 16 == 0 )); then
            printf "\033[0m\n"
        fi
    done
}

# blastem
# Permanently remove zsh history and session state, then kill this shell.
# All deletions are attempted; failures are reported in aggregate.
# Other running shells may later recreate history from their in-memory state.
# ~/.zsh_sessions contains all terminal sessions, not only the current one.
#
# Note: on APFS (the default macOS filesystem since High Sierra) file
# deletion does not guarantee physical erasure — APFS is copy-on-write
# and may retain data in snapshots or freed blocks. FileVault (full-disk
# encryption) is the real control for data-at-rest protection.
blastem() {
    emulate -L zsh
    setopt null_glob rm_star_silent

    [[ -t 0 ]] || {
        echo "blastem requires an interactive terminal" >&2
        return 1
    }

    echo "WARNING: this removes zsh history, completion dumps, and all saved zsh sessions."
    printf "Type 'DELETE ALL ZSH HISTORY' to continue: "

    local answer
    read -r answer
    [[ "$answer" == "DELETE ALL ZSH HISTORY" ]] || {
        echo "Aborted."
        return 1
    }

    unset HISTFILE

    local -i failed=0
    command rm -f -- "$HOME/.zsh_history" 2>/dev/null || {
        echo "failed to remove: $HOME/.zsh_history" >&2
        failed=1
    }
    command rm -f -- "$HOME"/.zcompdump* 2>/dev/null || {
        echo "failed to remove: $HOME/.zcompdump*" >&2
        failed=1
    }
    command rm -rf -- "$HOME/.zsh_sessions" 2>/dev/null || {
        echo "failed to remove: $HOME/.zsh_sessions" >&2
        failed=1
    }

    (( failed )) && {
        echo "one or more deletions failed; shell not killed" >&2
        return 1
    }

    kill -KILL $$
}

# generate_modhex [bytes=16]
# Generate one cryptographically secure Modhex string.
# Raw arguments are bounded by digit length before integer conversion, and
# conversion uses an explicit 10# base so leading zeros cannot be
# re-interpreted under octal_zeroes.
generate_modhex() {
    emulate -L zsh -o pipefail
    _require_cmd openssl || return 1
    _require_cmd tr || return 1

    local raw_bytes=${1:-16}

    [[ "$raw_bytes" == <1-> && ${#raw_bytes} -le 7 ]] || {
        echo "bytes must be a positive integer of at most 7 digits" >&2
        return 1
    }

    local -i bytes=$(( 10#$raw_bytes ))
    (( bytes <= 500000 )) || {
        echo "bytes must not exceed 500000" >&2
        return 1
    }

    command openssl rand -hex "$bytes" | _modhex
}

# generate_modhex_bulk [count=1] [chars=32]
# Generate multiple Modhex strings in one pipeline. Character count must be
# even because each random byte produces two hexadecimal characters. Total
# output is capped at 1,000,000 characters. Raw arguments are bounded by
# digit length before integer conversion, conversion forces base 10, and the
# total-output limit uses division so the check itself cannot overflow.
generate_modhex_bulk() {
    emulate -L zsh -o pipefail
    _require_cmd openssl || return 1
    _require_cmd tr || return 1
    _require_cmd fold || return 1

    local raw_count=${1:-1}
    local raw_chars=${2:-32}

    [[ "$raw_count" == <1-> && ${#raw_count} -le 7 \
        && "$raw_chars" == <1-> && ${#raw_chars} -le 7 ]] || {
        echo "count and chars must be positive integers of at most 7 digits" >&2
        return 1
    }

    local -i count=$(( 10#$raw_count ))
    local -i chars=$(( 10#$raw_chars ))

    (( chars % 2 == 0 )) || {
        echo "chars must be even" >&2
        return 1
    }

    (( count <= 1000000 / chars )) || {
        echo "refusing to generate more than 1,000,000 characters" >&2
        return 1
    }

    command openssl rand -hex $(( count * chars / 2 )) \
        | command tr -d ' \n' \
        | command fold -w "$chars" \
        | _modhex
}

