# getvid <folder> <url>
# Download a video into ~/Movies/yt-dlp/<folder>.
getvid() {
    emulate -L zsh
    _require "$1" "folder" || return 1
    _require "$2" "url" || return 1
    _require_cmd yt-dlp || return 1

    if [[ "$1" == "." || "$1" == ".." || "$1" == */* ]]; then
        echo "folder must be one name and cannot be '.' or '..'" >&2
        return 1
    fi

    local target="$HOME/Movies/yt-dlp/$1"
    command mkdir -p -- "$target" || return 1

    command yt-dlp --merge-output-format mkv \
        -o "${target}/%(title)s.%(ext)s" -- "$2"
}

# dedupe [dir...]
# List duplicate files recursively. Default to the current directory.
dedupe() {
    emulate -L zsh
    _require_cmd fdupes || return 1

    if (( $# )); then
        command fdupes -r -- "$@"
    else
        command fdupes -r -- .
    fi
}

# resetmp3tag
# Reset Mp3tag security-scoped bookmarks to fix repeated access prompts.
resetmp3tag() {
    emulate -L zsh
    _require_cmd defaults || return 1
    command defaults delete app.mp3tag.Mp3tag SecurityScopedBookmarks
}

